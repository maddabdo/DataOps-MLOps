# ==============================================================================
# Environment Configuration - Air Quality Monitoring Platform
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=raw_data
KAFKA_TOPIC_PROCESSED=processed_data
KAFKA_TOPIC_ANOMALIES=anomalies
KAFKA_CONSUMER_GROUP=air-quality-consumer-group

# PostgreSQL Database Configuration
POSTGRES_USER=airquality_user
POSTGRES_PASSWORD=airquality_password
POSTGRES_DB=air_quality_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://airquality_user:airquality_password@localhost:5432/air_quality_db
# Set USE_SQLITE_FALLBACK=true to use local SQLite if PostgreSQL is unreachable
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=data/air_quality.db

# MLflow Tracking Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=air_quality_anomaly_detection
MLFLOW_MODEL_NAME=AirQualityAnomalyClassifier
MLFLOW_STAGE=Production

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Streamlit Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Apache Airflow Configuration
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_EMAIL_ALERT=y.lamari@uiz.ac.ma
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/WEBHOOK/URL

# Team Member Jira Identifiers
JIRA_INSTANCE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=AQM
JIRA_USER_EMAIL=project-lead@example.com
JIRA_API_TOKEN=YOUR_JIRA_API_TOKEN
MEMBER_1_ACCOUNT_ID=MEMBER_1_PROJECT_MANAGER
MEMBER_2_ACCOUNT_ID=MEMBER_2_DATA_ENGINEER
MEMBER_3_ACCOUNT_ID=MEMBER_3_ML_ENGINEER
